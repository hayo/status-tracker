# Een openbare teampagina op naam: team/delta-wolves gaat naar team.php?naam=delta-wolves.
# Zonder mod_rewrite werkt team.php?naam=delta-wolves ook.

# Een site kan .php-bestanden afschermen, zoals hayobethlehem.nl doet (alleen opslag.php mag). team.php
# moet de bezoeker wel zelf kunnen opvragen; deze regel gaat voor die van een map hoger. Beide
# schrijfwijzen, want de site kan de oude (Order, Deny) of de nieuwe (Require) gebruiken.
<Files "team.php">
    <IfModule mod_access_compat.c>
        Order allow,deny
        Allow from all
    </IfModule>
    Require all granted
</Files>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^team/([a-z0-9-]+)/?$ team.php?naam=$1 [L,QSA]
</IfModule>
